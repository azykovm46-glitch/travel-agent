# LLM: любой OpenAI-совместимый API с поддержкой tool calling
# OpenRouter: https://openrouter.ai/api/v1 ; OpenAI: https://api.openai.com/v1 ; Ollama: http://localhost:11434/v1
# Polza.ai: https://polza.ai/api/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Впиши id модели из каталога провайдера (быстрая и дешёвая модель с tool calling)
LLM_MODEL=
# Запасная модель на случай сбоя основной (необязательно)
LLM_FALLBACK_MODEL=
LLM_TIMEOUT=25
# Повторов основной модели на 503/таймаут (0–2) и пауза между ними, с; потом — запасная модель
LLM_RETRIES=1
LLM_RETRY_PAUSE=2
# Рассуждения «думающих» моделей: none — быстрее и не съедает max_tokens ответа (Polza, OpenRouter).
# Пусто — не отправлять (OpenAI, Ollama)
LLM_REASONING_EFFORT=

# 1 = работать без LLM (правила + шаблоны)
AGENT_OFFLINE=0

# Модуль инструментов: моки или реальный бэкенд участника 2 (tools.real_backend — адаптер к ../hackathon-backend)
TOOLS_BACKEND=tools.mock_backend
# Где лежит бэкенд участника 2, если не рядом с репозиторием
HACKATHON_BACKEND_DIR=

CORS_ORIGINS=*

# С какого режима разбора начинать: tools | json | text (агент сам спустится ниже, если модель не умеет)
LLM_EXTRACT_MODE=tools

# SQLite с профилями пользователей и сессиями (переживают перезапуск сервера);
# по умолчанию data/profiles.sqlite3
MEMORY_DB=
